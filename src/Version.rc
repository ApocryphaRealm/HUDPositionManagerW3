// The .asi's VERSIONINFO (rule 6: a build carries its own number; version-gate.ps1 reads FileVersion at the package gate).
// HPM_VMAJOR / HPM_VMINOR / HPM_VPATCH / HPM_VERSION come from xmake.lua's set_version, which only version-gate.ps1 writes.
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION HPM_VMAJOR, HPM_VMINOR, HPM_VPATCH, 0
PRODUCTVERSION HPM_VMAJOR, HPM_VMINOR, HPM_VPATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "HUD Position Manager (The Witcher 3)"
			VALUE "FileVersion", HPM_VERSION
			VALUE "InternalName", "HUDPositionManager"
			VALUE "LegalCopyright", "GPL-3.0-or-later"
			VALUE "OriginalFilename", "HUDPositionManager.asi"
			VALUE "ProductName", "HUD Position Manager"
			VALUE "ProductVersion", HPM_VERSION
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
