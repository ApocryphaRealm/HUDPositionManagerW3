<?xml version="1.0" encoding="UTF-8"?>
<!-- Square Minimap: Options > Mods > Square Minimap (and the same page in Apocrypha Menu Framework). Added for testing
     the placement (the owner, 2026-10-06: "give it an in-game settings page just to make editing it more easy for
     testing"). Values are the HUD's own units (1920 x 1080 screen). The script reads them twice a second and passes
     them to the minimap movie, so a change shows at once. An empty value means the default (SquareMinimap.ws):
       Top 20, Right 20, QuestGap 8. -->
<UserConfig>
	<Group id="SquareMinimap" displayName="Mods.sqm_menu">
		<VisibleVars>
			<Var id="Top" displayName="sqm_top" displayType="SLIDER;0;100;100"/>
			<Var id="Right" displayName="sqm_right" displayType="SLIDER;0;100;100"/>
			<Var id="QuestGap" displayName="sqm_quest_gap" displayType="SLIDER;0;50;50"/>
		</VisibleVars>
	</Group>
</UserConfig>
