<?xml version="1.0" encoding="UTF-8"?>
<!-- HUD Position Manager (formerly Square Minimap): Options > Mods > HUD Position Manager (and the same page in Apocrypha
     Menu Framework). Values are the HUD's own units (1920 x 1080 screen), except Zoom (percent of the game's own minimap
     zoom). HUDPositionManager.ws reads them twice a second, so a change shows at once (the dialogue choices: from the next
     set of choices). An empty value means the default:
       Top 4, Right 4 (the square moves further in when the quest text centred under it needs the room), QuestGap 8,
       Zoom 100, PlayerLeft 8, PlayerBottom 8 (the player widget in the bottom left - the owner, 2026-10-07),
       ItemsLeft 8, ItemsTop 8 (the quick items in the top left), DialogueRight on, DialogueGap 40 (the dialogue choices
       on the right, their longest line 40 units from the edge), DialogueY 0; every <Widget>X / <Widget>Y 0 - an offset
       from where the game puts that widget, left (-) / right (+), up (-) / down (+); SignX/Y and SkullX/Y move the
       player widget's two badges apart from their bars (the owner, 2026-10-07).
     Sliders move one unit per nudge (rule: steps = max - min). -->
<UserConfig>
	<Group id="HUDPositionManager" displayName="Mods.sqm_menu">
		<VisibleVars>
			<Var id="Zoom" displayName="sqm_zoom" displayType="SLIDER;50;300;250"/>
			<Var id="Top" displayName="sqm_top" displayType="SLIDER;0;1000;1000"/>
			<Var id="Right" displayName="sqm_right" displayType="SLIDER;0;1800;1800"/>
			<Var id="QuestGap" displayName="sqm_quest_gap" displayType="SLIDER;0;100;100"/>
			<Var id="PlayerLeft" displayName="sqm_player_left" displayType="SLIDER;0;1800;1800"/>
			<Var id="PlayerBottom" displayName="sqm_player_bottom" displayType="SLIDER;0;1000;1000"/>
			<Var id="ItemsLeft" displayName="sqm_items_left" displayType="SLIDER;0;1800;1800"/>
			<Var id="ItemsTop" displayName="sqm_items_top" displayType="SLIDER;0;1000;1000"/>
			<Var id="DialogueRight" displayName="sqm_dialogue_right" displayType="TOGGLE"/>
			<Var id="DialogueGap" displayName="sqm_dialogue_gap" displayType="SLIDER;0;600;600"/>
			<Var id="DialogueY" displayName="sqm_dialogue_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="SignX" displayName="sqm_sign_x" displayType="SLIDER;-300;300;600"/>
			<Var id="SignY" displayName="sqm_sign_y" displayType="SLIDER;-300;300;600"/>
			<Var id="SkullX" displayName="sqm_skull_x" displayType="SLIDER;-300;300;600"/>
			<Var id="SkullY" displayName="sqm_skull_y" displayType="SLIDER;-300;300;600"/>
			<Var id="BuffsX" displayName="sqm_buffs_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="BuffsY" displayName="sqm_buffs_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="HintsX" displayName="sqm_hints_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="HintsY" displayName="sqm_hints_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="MessagesX" displayName="sqm_messages_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="MessagesY" displayName="sqm_messages_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="SubtitlesX" displayName="sqm_subtitles_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="SubtitlesY" displayName="sqm_subtitles_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="AreaX" displayName="sqm_area_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="AreaY" displayName="sqm_area_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="JournalX" displayName="sqm_journal_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="JournalY" displayName="sqm_journal_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="LootFeedX" displayName="sqm_lootfeed_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="LootFeedY" displayName="sqm_lootfeed_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="EnemyX" displayName="sqm_enemy_x" displayType="SLIDER;-1920;1920;3840"/>
