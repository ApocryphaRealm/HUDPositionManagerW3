			<Var id="BreathX" displayName="sqm_breath_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="BreathY" displayName="sqm_breath_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="HorseStaminaX" displayName="sqm_horsestamina_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="HorseStaminaY" displayName="sqm_horsestamina_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="HorseFearX" displayName="sqm_horsefear_x" displayType="SLIDER;-1920;1920;3840"/>
