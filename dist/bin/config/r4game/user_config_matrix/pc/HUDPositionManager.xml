			<Var id="TimeLeftX" displayName="sqm_timeleft_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="TimeLeftY" displayName="sqm_timeleft_y" displayType="SLIDER;-1080;1080;2160"/>
			<Var id="TimeLapseX" displayName="sqm_timelapse_x" displayType="SLIDER;-1920;1920;3840"/>
			<Var id="TimeLapseY" displayName="sqm_timelapse_y" displayType="SLIDER;-1080;1080;2160"/>
		</VisibleVars>
	</Group>
</UserConfig>
