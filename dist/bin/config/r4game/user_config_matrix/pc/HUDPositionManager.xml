<?xml version="1.0" encoding="UTF-8"?>
<!-- HUD Position Manager. Not shown in any menu (visibilityCondition="hideAlways"): since 2026-10-07 the settings page is on
     the Apocrypha Menu Framework (bin\x64_dx12\HUDPositionManager.asi), organised as the Skyrim and Oblivion versions are.
     Layout - the whole layout as one string, written by the page; HUDPositionManager.ws hands it to the HUD movies.
     Report - which HUD elements exist and their boxes, written by the script for the page. -->
<UserConfig>
	<Group id="HUDPositionManager" displayName="hidden" visibilityCondition="hideAlways">
		<VisibleVars>
			<Var id="Layout" displayName="HPMLayout" displayType="TOGGLE"/>
			<Var id="Report" displayName="HPMReport" displayType="TOGGLE"/>
		</VisibleVars>
	</Group>
</UserConfig>
